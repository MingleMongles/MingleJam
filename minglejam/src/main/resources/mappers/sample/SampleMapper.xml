<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.minglemongles.minglejam.sample.query.repository.SampleMapper">
    <resultMap id="sampleResultMap" type="com.minglemongles.minglejam.sample.query.dto.SampleDTO">
        <id property="id" column="id"/>
        <result property="name" column="name"/>
    </resultMap>

    <select id="getSamples" resultMap="sampleResultMap">
        SELECT
        a.id,
        a.name
        FROM tb_sample a
    </select>
</mapper>